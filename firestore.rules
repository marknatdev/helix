rules_version = '2';

// HELIX Smart Helmet Command Center — Firestore rules.
// All privileged writes go through Cloud Functions (Admin SDK, bypasses these rules);
// clients only read, plus the narrow client-writable exceptions spelled out below.
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthed() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // `role` (see spec-device-pairing-system.md, D6) is only ever set by an
    // admin-invoked Cloud Function via the Admin SDK — it must never appear in
    // any client-writable field allowlist below, or any user could grant
    // themselves admin with a single Firestore write.
    function isAdmin() {
      return isAuthed() && userDoc().role == 'admin';
    }

    // Users can read only their own profile. No client writes at all (D9):
    // `helmetIds` is written only by the Claim/Unclaim Cloud Functions,
    // `role` only by the admin bootstrap/grant function — both via Admin SDK,
    // which bypasses these rules entirely. The doc is created lazily by
    // those same Admin SDK writes the first time it's needed.
    match /users/{uid} {
      allow read: if isAuthed() && request.auth.uid == uid;
      allow create, update, delete: if false;
    }

    // ─── LoRaWAN helmet telemetry (written by local webhook server or dev config page) ──────
    match /helmets/{helmetId} {
      allow read: if isAuthed()
        && helmetId in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.helmetIds;
      allow write: if isAuthed()
        && helmetId in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.helmetIds;

      // Pairing code hash (D1, D2) — only functions/index.js's claim/provision
      // routes ever touch this, via Admin SDK. Never client-readable: an
      // unclaimed helmet isn't in anyone's helmetIds yet, so the parent read
      // rule above wouldn't grant access anyway, but this is explicit rather
      // than relying on that as the only guard.
      match /private/{docId} {
        allow read, write: if false;
      }
    }

    // Top-level alerts collection for device-generated alerts.
    match /alerts/{alertId} {
      allow read: if isAuthed();
      // A user may resolve alerts for helmets registered to their own account;
      // admins may resolve any alert regardless of claim state (D14 — keeps
      // SOS/battery alerts actionable during the pairing-system re-claim rollout).
      allow update: if isAuthed()
        && (resource.data.helmetId in userDoc().helmetIds || isAdmin())
        && request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['resolved']);
      allow create, delete: if false;  // Only admin SDK creates.
    }

    // Bootstrap/admin marker doc (see functions/index.js POST /admin/bootstrap).
    // Admin SDK only — never client-readable or client-writable.
    match /system/{docId} {
      allow read, write: if false;
    }

    // Zone geofences (POST /zones etc. in functions/index.js). Any signed-in
    // user may create/assign a zone, but only via the backend's ownership
    // checks — never a direct client write, same reasoning as `alerts`.
    match /zones/{zoneId} {
      allow read: if isAuthed();
      allow write: if false;
    }

    // Receiver gateways (D3). Admins may read the non-sensitive record;
    // provisioning/revocation only happens via Admin SDK (functions/index.js).
    match /receivers/{receiverId} {
      allow read: if isAdmin();
      allow write: if false;

      // Credential verifier hash lives in its own server-only doc — Firestore
      // rules can't field-filter a single document, so this is how the raw
      // credential's hash stays unreadable by any client, admin included.
      match /private/{docId} {
        allow read, write: if false;
      }
    }
  }
}
