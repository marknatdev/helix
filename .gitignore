# Local webhook server
functions/node_modules/
functions/.env
functions/serviceAccountKey.json

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# IDEs and AI Agents
.claude/
.trae/
.windsurf/
.agents/
.hermes/

# interview-me spec verify caches (regenerable; the .interview.json files are tracked)
.*.verify-cache.json

